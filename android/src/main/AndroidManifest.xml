<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into crates/app/AndroidManifest.xml's app by the manifest merger. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Oral mode with the screen off (OralService): a foreground media
         service, and a partial wake lock so the think timer keeps running.
         Media-session notifications don't need POST_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A light tap with answer feedback (app.batna.Haptics; Settings › Study
         can turn it off). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+: daily study reminders are notifications (Reminders.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms the local reminder schedule after a reboot (Reminders.kt). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <service
            android:name="app.batna.OralService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Posts a planned reminder; re-arms the schedule after a reboot, an
             update or a clock or time-zone change. Not exported: these
             system broadcasts still reach it. -->
        <receiver android:name="app.batna.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <!-- Settings › Your data: the system "Save to" dialog for an export and
             the file picker for a restore (Documents.kt). Invisible; it stays
             alive under the system dialog to get the result. -->
        <activity
            android:name="app.batna.DocumentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
